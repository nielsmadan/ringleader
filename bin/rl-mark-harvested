#!/usr/bin/env python3
from __future__ import annotations

import argparse
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO))

from ringleader import registry  # noqa: E402

DEFAULT_REGISTRY = REPO / "registry.json"


def main():
    ap = argparse.ArgumentParser(prog="rl-mark-harvested")
    ap.add_argument("id")
    ap.add_argument("--paths", default="", help="comma-separated doc paths harvested into")
    ap.add_argument("--registry", default=str(DEFAULT_REGISTRY))
    args = ap.parse_args()

    paths = [p.strip() for p in args.paths.split(",") if p.strip()]
    reg = registry.load_registry(args.registry)
    try:
        registry.mark_harvested(reg, args.id, paths)
    except KeyError:
        print(f"rl-mark-harvested: unknown session {args.id}", file=sys.stderr)
        sys.exit(1)
    registry.save_registry(args.registry, reg)
    print(f"marked harvested {args.id} ({len(paths)} docs)")


if __name__ == "__main__":
    main()
