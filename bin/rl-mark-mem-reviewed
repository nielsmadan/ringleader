#!/usr/bin/env python3
# bin/rl-mark-mem-reviewed
from __future__ import annotations
import argparse, sys
from pathlib import Path
REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO))
from ringleader import registry  # noqa: E402
DEFAULT_REGISTRY = REPO / "registry.json"

def main():
    ap = argparse.ArgumentParser(prog="rl-mark-mem-reviewed")
    ap.add_argument("path")
    ap.add_argument("--registry", default=str(DEFAULT_REGISTRY))
    args = ap.parse_args()
    reg = registry.load_registry(args.registry)
    try:
        registry.mark_memory_reviewed(reg, args.path)
    except KeyError:
        print(f"rl-mark-mem-reviewed: no memory entry at {args.path}", file=sys.stderr)
        sys.exit(1)
    registry.save_registry(args.registry, reg)
    print(f"reviewed {args.path}")

if __name__ == "__main__":
    main()
